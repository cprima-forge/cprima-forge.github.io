{
  "version": 1,
  "entitlements": [
    {
      "id": "use",
      "description": "Run the artefact for its intended purpose. The baseline grant; a product that grants nothing else still grants this.\n"
    },
    {
      "id": "use-commercial",
      "description": "Use in work performed for payment, including by an organisation. Distinct from `use` so a free tier can be limited to evaluation and personal use without changing anything about the artefact itself.\n"
    },
    {
      "id": "source",
      "description": "Receive the preferred form for making modifications. Relevant where the published artefact is compiled and the sources are not otherwise shipped.\n"
    },
    {
      "id": "support",
      "description": "A response to a report, rather than best effort. Says nothing about a time bound; that belongs to the offer, not the grant.\n"
    },
    {
      "id": "updates",
      "description": "Continue to receive new versions. Bounded by `duration` on the offer when it is not perpetual.\n"
    }
  ],
  "seat_models": [
    {
      "id": "single-user",
      "description": "One named person, any number of their own machines."
    },
    {
      "id": "per-machine",
      "description": "A fixed number of activations, machine-bound."
    },
    {
      "id": "site",
      "description": "Unlimited within one organisation."
    },
    {
      "id": "unlimited-machines",
      "description": "Any number of machines for one holder. Distinct from `site`, which is bounded by an organisation: this is bounded by nothing. Enforcement still applies a practical ceiling to catch pathological use, but that number is not a term of the offer and is not stated here.\n"
    }
  ],
